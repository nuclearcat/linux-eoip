/* Generated by CMake from config.h.in -- do not edit. */
#ifndef LINUX_EOIP_CONFIG_H
#define LINUX_EOIP_CONFIG_H

#define PACKAGE_VERSION "@PROJECT_VERSION@"

/* Defined when vip is built against liblzo2 and can (de)compress payloads */
#cmakedefine HAVE_LIBLZO2 1

/* Defined when recvmmsg() is available, so the receive ring can be filled
   with a single syscall per batch rather than one per packet */
#cmakedefine HAVE_RECVMMSG 1

/* Defined when sendmmsg() is available, so a batch of packets leaves in a
   single syscall rather than one sendto per packet */
#cmakedefine HAVE_SENDMMSG 1

/* Defined when the threads can be pinned to a core */
#cmakedefine HAVE_PTHREAD_SETAFFINITY_NP 1

/* Buffer sizing, from the CMake cache variables of the same name. These are
   memory against throughput tradeoffs for the target device. */
#define EOIP_MAXPAYLOAD @EOIP_MAXPAYLOAD@
#define VIP_MAXPAYLOAD  @VIP_MAXPAYLOAD@
#define RING_SLOTS      @RING_SLOTS@
#define TX_BATCH        @TX_BATCH@

#endif
