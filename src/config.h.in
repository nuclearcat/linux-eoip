#ifndef LINUX_EOIP_CONFIG_H
#define LINUX_EOIP_CONFIG_H

#define PACKAGE_VERSION "@PROJECT_VERSION@"

/* Defined when vip is built against liblzo2 and can (de)compress payloads */
#cmakedefine HAVE_LIBLZO2 1

/* Defined when recvmmsg() is available, so the receive ring can be filled
   with a single syscall per batch rather than one per packet */
#cmakedefine HAVE_RECVMMSG 1

